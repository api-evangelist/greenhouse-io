          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_test_id\": \"<string>\",\n  \"candidate\": {\n    \"first_name\": \"<string>\",\n    \"last_name\": \"<string>\",\n    \"email\": \"<email>\",\n    \"greenhouse_application_id\": \"<integer>\"\n  },\n  \"metadata\": {\n    \"occaecatd6\": \"exercitati\"\n  }\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/send_test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "send_test"
              ]
            },
            "description": "Greenhouse calls this when a candidate reaches the assessment stage; partner returns a unique partner_interview_id."
          },
