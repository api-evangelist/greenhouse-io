{
  "info": {
    "_postman_id": "35be5fdf-82ae-4b30-9f24-d454e6bde432",
    "name": "Greenhouse Assessment Partner ActivityFeed TestDelivery API",
    "description": "The Assessment Partner API defines the contract that assessment vendors implement so\nGreenhouse can list available tests, send a test to a candidate, and retrieve the\ncandidate's results. Endpoints are hosted by the partner (not Greenhouse) and are\nsecured with HTTP Basic over HTTPS. Greenhouse may also receive PATCH callbacks from\nthe partner with completed test status; otherwise it polls `test_status` hourly for\nup to 8 weeks. API keys must be fewer than 171 characters.\n\n\nContact Support:\n Name: Greenhouse Software\n Email: developers@greenhouse.io",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:51:58.000Z",
    "updatedAt": "2026-07-28T01:51:58.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-35be5fdf-82ae-4b30-9f24-d454e6bde432"
  },
  "item": [
    {
