{
  "opencollection": "1.0.0",
  "info": {
    "name": "Greenhouse Assessment Partner ActivityFeed Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Current Partner User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/current_user",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve Current Partner User"
        },
        {
          "info": {
            "name": "List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Default 100, max 500."
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List Users"
        },
        {
          "info": {
            "name": "Create User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{partner_host}/{base_path}/users",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create User"
        },
        {
          "info": {
            "name": "Retrieve User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve User"
        },
        {
          "info": {
            "name": "Update User",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{partner_host}/{base_path}/users/:id",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update User"
        },
        {
          "info": {
            "name": "Add User Email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{partner_host}/{base_path}/users/:id/email_addresses",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add User Email"
        }
      ]
    }
  ],
  "bundled": true
}