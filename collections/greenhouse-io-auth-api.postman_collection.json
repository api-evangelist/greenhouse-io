          "name": "Issue Audit Log Access Token",
          "request": {
            "name": "Issue Audit Log Access Token",
            "description": {
              "content": "Exchanges a Harvest API key (HTTP Basic) for a JWT bearer token valid for 24 hours.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "auth",
                "jwt_access_token"
              ],
              "host": [
                "harvest",
                "greenhouse",
                "io"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST"
          },
          "response": [
            {
              "id": "50e39284-d7c1-4a9d-a3a4-216bbaa4bdd0",
              "name": "Token issued.",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "auth",
                    "jwt_access_token"
                  ],
                  "host": [
                    "harvest",
                    "greenhouse",
                    "io"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 4030\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
