{
  "opencollection": "1.0.0",
  "info": {
    "name": "Greenhouse Assessment Partner ActivityFeed ProspectPools API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "ProspectPools",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Partner Prospect Pools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/prospect_pools",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ]
          },
          "docs": "List Partner Prospect Pools"
        },
        {
          "info": {
            "name": "Retrieve Prospect Pool",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/prospect_pools/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve Prospect Pool"
        }
      ]
    }
  ],
  "bundled": true
}