{
  "opencollection": "1.0.0",
  "info": {
    "name": "Greenhouse Assessment Partner ActivityFeed Approvals API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Approvals",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List User Pending Approvals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/users/:id/pending_approvals",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List User Pending Approvals"
        },
        {
          "info": {
            "name": "Create Approval Flow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{partner_host}/{base_path}/approval_flows",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Approval Flow"
        },
        {
          "info": {
            "name": "Retrieve Approval Flow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/approval_flows/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve Approval Flow"
        },
        {
          "info": {
            "name": "Replace Approver",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{partner_host}/{base_path}/approval_flows/:id/approval_groups/:group_id/approvers/:user_id",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "group_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Replace Approver"
        },
        {
          "info": {
            "name": "List Job Approval Flows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/jobs/:job_id/approval_flows",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Job Approval Flows"
        },
        {
          "info": {
            "name": "Replace Job Approval Flow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{partner_host}/{base_path}/jobs/:job_id/approval_flows",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replace Job Approval Flow"
        }
      ]
    }
  ],
  "bundled": true
}