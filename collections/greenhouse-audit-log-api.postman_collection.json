    {
      "id": "b4eafc53-1358-43fc-9771-1cc9555701b1",
      "name": "Auth",
      "description": {
        "content": "JWT access token issuance.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d4b773fe-d296-41d5-a32f-0a9bcf549d9d",
          "name": "Issue Audit Log Access Token",
          "request": {
            "name": "Issue Audit Log Access Token",
            "description": {
              "content": "Exchanges a Harvest API key (HTTP Basic) for a JWT bearer token valid for 24 hours.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "auth",
                "jwt_access_token"
              ],
              "host": [
                "harvest",
                "greenhouse",
                "io"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "da474989-efee-4691-a9ba-0424f0eb8cbe",
              "name": "Token issued.",
              "originalRequest": {
                "url": {
                  "protocol": "https",
                  "path": [
                    "auth",
                    "jwt_access_token"
                  ],
                  "host": [
                    "harvest",
                    "greenhouse",
                    "io"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 1566\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
