  "info": {
    "_postman_id": "75d7a0f8-03b5-49e5-ad61-5797875e7e16",
    "name": "Greenhouse Audit Log API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Audit Log API exposes a record of important events that occurred in Greenhouse\nduring the prior 30 days, including who performed each event, the event target,\nand supporting request metadata. Authentication uses a short-lived JWT obtained\nfrom POST https://harvest.greenhouse.io/auth/jwt_access_token using a Harvest API key.\nRate limits: 50 requests / 10s on standard reads, 3 requests / 30s on paginated reads.\n\n\nContact Support:\n Name: Greenhouse Software\n Email: developers@greenhouse.io",
      "type": "text/plain"
    }
  }
