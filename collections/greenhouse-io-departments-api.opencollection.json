{
  "opencollection": "1.0.0",
  "info": {
    "name": "Greenhouse Assessment Partner ActivityFeed Departments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Departments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Departments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/departments"
          },
          "docs": "List Departments"
        },
        {
          "info": {
            "name": "Create Department",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{partner_host}/{base_path}/departments",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Department"
        },
        {
          "info": {
            "name": "Retrieve Department",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/departments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve Department"
        },
        {
          "info": {
            "name": "Update Department",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{partner_host}/{base_path}/departments/:id",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update Department"
        }
      ]
    }
  ],
  "bundled": true
}