{
  "opencollection": "1.0.0",
  "info": {
    "name": "Greenhouse Assessment Partner ActivityFeed Tags API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Candidate Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/candidate_tags"
          },
          "docs": "List Candidate Tags"
        },
        {
          "info": {
            "name": "Create Candidate Tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{partner_host}/{base_path}/candidate_tags",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Candidate Tag"
        },
        {
          "info": {
            "name": "Delete Candidate Tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{partner_host}/{base_path}/candidate_tags/:id",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Candidate Tag"
        },
        {
          "info": {
            "name": "List Candidate Candidate Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{partner_host}/{base_path}/candidates/:id/candidate_tags",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List Candidate Candidate Tags"
        },
        {
          "info": {
            "name": "Replace Candidate Tags",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{partner_host}/{base_path}/candidates/:id/candidate_tags",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replace Candidate Tags"
        },
        {
          "info": {
            "name": "Remove Candidate Tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{partner_host}/{base_path}/candidates/:id/candidate_tags/:tag_id",
            "headers": [
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "tag_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Remove Candidate Tag"
        }
      ]
    }
  ],
  "bundled": true
}