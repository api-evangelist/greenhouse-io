          "name": "Execute Onboarding GraphQL",
          "request": {
            "name": "Execute Onboarding GraphQL",
            "description": {
              "content": "Execute a GraphQL query or mutation against the Greenhouse Onboarding schema.\nSupported root queries include `employee(id)`, `employees`, `departments`,\n`locations`, `customFields`, `teams`, and `rateLimit`. Supported mutations\ninclude department / location CRUD, `addPendingHire`, and `updateEmployeeProfile`.\nErrors use the GraphQL `errors` array with codes: Authentication, Validation,\nNotFound, Server, RateLimit.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "graphql"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
